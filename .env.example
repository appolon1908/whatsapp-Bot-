# Copy to .env. Generate independent 32-byte hexadecimal values for all three passwords.
# No default password is supplied. Existing PostgreSQL volumes preserve their passwords.
COMMERCE_POSTGRES_ADMIN_PASSWORD=
COMMERCE_APP_PASSWORD=
COMMERCE_MIGRATOR_PASSWORD=

# Runtime identity and authenticated internal ingress: fill before readiness can succeed.
COMMERCE_JWT_ISSUER=
COMMERCE_JWT_AUDIENCE=
COMMERCE_JWKS_URL=
# Alternatively provide COMMERCE_JWT_PUBLIC_KEY, never both identity key sources.
COMMERCE_JWT_PUBLIC_KEY=
COMMERCE_INGRESS_SECRET=

# Worker is an explicit Compose profile. Use a JSON array of onboarded business UUIDs.
COMMERCE_WORKER_TENANT_IDS=[]
COMMERCE_OUTBOUND_ENABLED=false
COMMERCE_POLICY_BASE_URL=
COMMERCE_POLICY_BEARER_TOKEN=
